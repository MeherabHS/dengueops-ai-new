{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [{"$ref": "#/$defs/p1"}, {"$ref": "#/$defs/p2"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uuid": {"type": "string", "format": "uuid"}, "dateTime": {"type": "string", "format": "date-time"},
    "policyP1": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"const": "RUNTIME.QUICK_FORECAST.COMPATIBILITY"}, "version": {"const": "p1.4f-v1"}, "sha256": {"const": "5e6bcb68e5f29a50f8d377892d7786cc1932b3435e8a0b709a363d6c2e42bb9a"}}},
    "policyP2": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"const": "RUNTIME.QUICK_FORECAST.COMPATIBILITY"}, "version": {"const": "p2-v1"}, "sha256": {"const": "4a6f166d037ab4c69df980549626d993db473bcec325fa2a68dbe5f8485a757e"}}},
    "training": {"type": "object", "additionalProperties": false, "required": ["datasetId", "featureMatrixSha256", "trainingRowCount", "trainingPeriod", "featureOrderSha256"], "properties": {"datasetId": {"$ref": "#/$defs/sha"}, "featureMatrixSha256": {"$ref": "#/$defs/sha"}, "trainingRowCount": {"type": "integer", "minimum": 1}, "trainingPeriod": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}, "end": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}}}, "featureOrderSha256": {"$ref": "#/$defs/sha"}}},
    "p1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "runId", "jobId", "datasetId", "deploymentId", "sourceType", "workflowMode", "activeModelId", "modelFamily", "parameterHash", "candidateRegistrySha256", "policy", "trainingDataIdentity", "latestObservedCases", "forecastRaw", "forecastReported", "targetPeriod", "target", "horizonWeeks", "forecastGrowthCategory", "reportingRoundingPolicy", "clippingApplied", "generatedAt", "preparednessAvailability", "uncertaintyAvailability"],
      "properties": {
        "schemaVersion": {"const": "1.0"}, "runId": {"$ref": "#/$defs/uuid"}, "jobId": {"$ref": "#/$defs/uuid"}, "datasetId": {"$ref": "#/$defs/sha"}, "deploymentId": {"const": "dhaka_south"}, "sourceType": {"const": "uploaded"}, "workflowMode": {"const": "quick_forecast"},
        "activeModelId": {"const": "random_forest"}, "modelFamily": {"const": "RandomForestRegressor"}, "parameterHash": {"$ref": "#/$defs/sha"}, "candidateRegistrySha256": {"$ref": "#/$defs/sha"}, "policy": {"$ref": "#/$defs/policyP1"}, "trainingDataIdentity": {"$ref": "#/$defs/training"},
        "latestObservedCases": {"type": "integer", "minimum": 0}, "forecastRaw": {"type": "number", "minimum": 0}, "forecastReported": {"type": "integer", "minimum": 0}, "targetPeriod": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}, "target": {"const": "target_cases_next_2w"}, "horizonWeeks": {"const": 2}, "forecastGrowthCategory": {"enum": ["Increasing", "Stable", "Decreasing"]}, "reportingRoundingPolicy": {"const": "nearest_integer_python_round_half_to_even"}, "clippingApplied": {"const": false}, "generatedAt": {"$ref": "#/$defs/dateTime"}, "preparednessAvailability": {"const": "unavailable_missing_planning_policy"}, "uncertaintyAvailability": {"enum": ["available", "pending_dataset_specific_calibration"]}
      }
    },
    "p2": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sourceFamily", "runId", "jobId", "datasetId", "deploymentId", "sourceType", "workflowMode", "activeModelId", "modelFamily", "parameterHash", "preprocessingIdentity", "candidateRegistrySha256", "policy", "trainingDataIdentity", "assignmentId", "assignmentCommitSha256", "lifecyclePolicyId", "lifecyclePolicyVersion", "lifecyclePolicySha256", "latestObservedCases", "forecastRaw", "forecastReported", "targetPeriod", "target", "horizonWeeks", "forecastGrowthCategory", "reportingRoundingPolicy", "clippingApplied", "generatedAt", "preparednessAvailability", "uncertaintyAvailability", "forecastPresentationMode", "calibrationStatus", "uncertaintyReasonCode", "deploymentModelAdopted"],
      "properties": {
        "schemaVersion": {"const": "2.0"}, "sourceFamily": {"const": "quick_forecast_p2"}, "runId": {"$ref": "#/$defs/uuid"}, "jobId": {"$ref": "#/$defs/uuid"}, "datasetId": {"$ref": "#/$defs/sha"}, "deploymentId": {"const": "dhaka_south"}, "sourceType": {"const": "uploaded"}, "workflowMode": {"const": "quick_forecast"},
        "activeModelId": {"type": "string", "minLength": 1}, "modelFamily": {"type": "string", "minLength": 1}, "parameterHash": {"$ref": "#/$defs/sha"}, "preprocessingIdentity": {"$ref": "#/$defs/sha"}, "candidateRegistrySha256": {"const": "74cb3635c5e211874ee5ad23196fc95bfdfbdb5c6438cc3d060f0b9ff49acfa0"}, "policy": {"$ref": "#/$defs/policyP2"}, "trainingDataIdentity": {"$ref": "#/$defs/training"},
        "assignmentId": {"$ref": "#/$defs/uuid"}, "assignmentCommitSha256": {"$ref": "#/$defs/sha"}, "lifecyclePolicyId": {"const": "RUNTIME.MODEL_LIFECYCLE.DECISION"}, "lifecyclePolicyVersion": {"const": "p2-v2"}, "lifecyclePolicySha256": {"$ref": "#/$defs/sha"},
        "latestObservedCases": {"type": "integer", "minimum": 0}, "forecastRaw": {"type": "number", "minimum": 0}, "forecastReported": {"type": "integer", "minimum": 0}, "targetPeriod": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"}, "target": {"const": "target_cases_next_2w"}, "horizonWeeks": {"const": 2}, "forecastGrowthCategory": {"enum": ["Increasing", "Stable", "Decreasing"]}, "reportingRoundingPolicy": {"const": "nearest_integer_python_round_half_to_even"}, "clippingApplied": {"const": false}, "generatedAt": {"$ref": "#/$defs/dateTime"}, "preparednessAvailability": {"const": "unavailable_missing_planning_policy"},
        "uncertaintyAvailability": {"enum": ["governed_available", "unavailable"]}, "forecastPresentationMode": {"enum": ["point_and_interval", "point_only"]}, "calibrationStatus": {"enum": ["governed_available", "unavailable"]}, "uncertaintyReasonCode": {"type": ["string", "null"]}, "deploymentModelAdopted": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"calibrationStatus": {"const": "governed_available"}}, "required": ["calibrationStatus"]}, "then": {"properties": {"uncertaintyAvailability": {"const": "governed_available"}, "forecastPresentationMode": {"const": "point_and_interval"}, "uncertaintyReasonCode": {"type": "null"}}}},
        {"if": {"properties": {"calibrationStatus": {"const": "unavailable"}}, "required": ["calibrationStatus"]}, "then": {"properties": {"uncertaintyAvailability": {"const": "unavailable"}, "forecastPresentationMode": {"const": "point_only"}, "uncertaintyReasonCode": {"const": "model_calibration_unavailable"}}}}
      ]
    }
  }
}
