        "validationStrategy": {"const": "rolling_origin_expanding_window"}, "foldCountRequired": {"type": "integer", "minimum": 1}, "foldCountCompleted": {"type": "integer", "minimum": 1}, "targetHorizonWeeks": {"const": 2}, "purgeGapWeeks": {"const": 2},
