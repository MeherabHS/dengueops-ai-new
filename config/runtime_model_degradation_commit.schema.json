{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p2"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "includedOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcomeId", "outcomeCommitSha256", "outcomeEvidenceSha256"],
        "properties": {
          "outcomeId": {"format": "uuid"},
          "outcomeCommitSha256": {"$ref": "#/$defs/sha"},
          "outcomeEvidenceSha256": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "assessmentReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessmentId", "assessmentCommitSha256", "candidateComparisonSha256"],
        "properties": {
          "assessmentId": {"format": "uuid"},
          "assessmentCommitSha256": {"$ref": "#/$defs/sha"},
          "candidateComparisonSha256": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "jobId", "deploymentId", "policyId", "policyVersion", "policySha256", "monitoringPolicyId", "monitoringPolicyVersion", "monitoringPolicySha256", "monitoringLatestPath", "monitoringLatestSha256", "monitoringSummaryPath", "monitoringSummarySha256", "includedOutcomeSetSha256", "includedOutcomes", "assessmentReferences", "includedCohortSetSha256", "artifactHashes", "status", "monitoringLatestModified", "forecastLatestModified", "profileModified", "deploymentModelModified", "authorizationModified", "lifecycleActionProduced", "committedAt"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "evidenceId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"const": "p2-v1"},
        "policySha256": {"$ref": "#/$defs/sha"},
        "monitoringPolicyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"},
        "monitoringPolicyVersion": {"const": "p2-v1"},
        "monitoringPolicySha256": {"const": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"},
        "monitoringLatestPath": {"const": "deployments/dhaka_south/monitoring/latest.json"},
        "monitoringLatestSha256": {"$ref": "#/$defs/sha"},
        "monitoringSummaryPath": {"type": "string", "pattern": "^forecast-outcomes/[0-9a-f-]+/artifacts/monitoring_summary\\.json$"},
        "monitoringSummarySha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "includedOutcomes": {"$ref": "#/$defs/includedOutcomes"},
        "assessmentReferences": {"$ref": "#/$defs/assessmentReferences"},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "artifactHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["degradation_evidence.json", "degradation_summary.json"],
          "properties": {
            "degradation_evidence.json": {"$ref": "#/$defs/sha"},
            "degradation_summary.json": {"$ref": "#/$defs/sha"}
          }
        },
        "status": {"const": "committed"},
        "monitoringLatestModified": {"const": false},
        "forecastLatestModified": {"const": false},
        "profileModified": {"const": false},
        "deploymentModelModified": {"const": false},
        "authorizationModified": {"const": false},
        "lifecycleActionProduced": {"const": false},
        "committedAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "jobId", "deploymentId", "policyId", "policyVersion", "policySha256", "monitoringPolicyId", "monitoringPolicyVersion", "monitoringPolicySha256", "monitoringLatestSnapshotPath", "monitoringLatestSnapshotSha256", "monitoringSummaryPath", "monitoringSummarySha256", "includedOutcomeSetSha256", "includedOutcomes", "assessmentReferences", "includedCohortSetSha256", "artifactHashes", "status", "monitoringLatestModified", "forecastLatestModified", "profileModified", "deploymentModelModified", "authorizationModified", "lifecycleActionProduced", "committedAt"],
      "properties": {
        "schemaVersion": {"const": "2.0"},
        "evidenceId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"const": "p2-v2"},
        "policySha256": {"const": "69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98"},
        "monitoringPolicyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"},
        "monitoringPolicyVersion": {"const": "p2-v2"},
        "monitoringPolicySha256": {"const": "5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6"},
        "monitoringLatestSnapshotPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/monitoring_latest_snapshot\\.json$"},
        "monitoringLatestSnapshotSha256": {"$ref": "#/$defs/sha"},
        "monitoringSummaryPath": {"type": "string", "pattern": "^forecast-outcomes/[0-9a-f-]+/artifacts/monitoring_summary\\.json$"},
        "monitoringSummarySha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "includedOutcomes": {"$ref": "#/$defs/includedOutcomes"},
        "assessmentReferences": {"$ref": "#/$defs/assessmentReferences"},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "artifactHashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["degradation_evidence.json", "degradation_summary.json", "monitoring_latest_snapshot.json"],
          "properties": {
            "degradation_evidence.json": {"$ref": "#/$defs/sha"},
            "degradation_summary.json": {"$ref": "#/$defs/sha"},
            "monitoring_latest_snapshot.json": {"$ref": "#/$defs/sha"}
          }
        },
        "status": {"const": "committed"},
        "monitoringLatestModified": {"const": false},
        "forecastLatestModified": {"const": false},
        "profileModified": {"const": false},
        "deploymentModelModified": {"const": false},
        "authorizationModified": {"const": false},
        "lifecycleActionProduced": {"const": false},
        "committedAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    }
  }
}
