{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assessmentId",
        "jobId",
        "workspaceId",
        "datasetId",
        "deploymentId",
        "assessmentPolicy",
        "candidateRegistrySha256",
        "foldPolicy",
        "foldPlanSha256",
        "plannedFoldCount",
        "candidateIds",
        "featureOrderSha256",
        "target",
        "horizonWeeks",
        "folds",
        "generatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "assessmentId": {
          "$ref": "#/$defs/p1/uuid"
        },
        "jobId": {
          "$ref": "#/$defs/p1/uuid"
        },
        "workspaceId": {
          "$ref": "#/$defs/p1/uuid"
        },
        "datasetId": {
          "$ref": "#/$defs/p1/sha"
        },
        "deploymentId": {
          "const": "dhaka_south"
        },
        "assessmentPolicy": {
          "$ref": "#/$defs/p1/assessmentPolicy"
        },
        "candidateRegistrySha256": {
          "$ref": "#/$defs/p1/sha"
        },
        "foldPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
            "policyVersion",
            "trainingWindow",
            "initialTrainingRows",
            "embargoRows",
            "validationRowsPerFold",
            "stepSizeWeeks",
            "samePlanForAllCandidates"
          ],
          "properties": {
            "policyId": {
              "const": "RUNTIME.ASSESSMENT.DYNAMIC_EXPANDING_FOLDS"
            },
            "policyVersion": {
              "const": "p1.4d-1-v1"
            },
            "trainingWindow": {
              "const": "expanding"
            },
            "initialTrainingRows": {
              "const": 104
            },
            "embargoRows": {
              "const": 1
            },
            "validationRowsPerFold": {
              "const": 1
            },
            "stepSizeWeeks": {
              "const": 1
            },
            "samePlanForAllCandidates": {
              "const": true
            }
          }
        },
        "foldPlanSha256": {
          "$ref": "#/$defs/p1/sha"
        },
        "plannedFoldCount": {
          "const": 68
        },
        "candidateIds": {
          "oneOf": [
            {"const": ["previous_week_naive", "moving_average_4w", "seasonal_naive_52w", "ridge_regression", "poisson_regression", "random_forest", "gradient_boosting"]},
            {"const": ["moving_average_4w", "seasonal_naive_52w", "ridge_regression", "poisson_regression", "random_forest", "gradient_boosting", "elastic_net", "negative_binomial_regression", "extra_trees", "hist_gradient_boosting"]}
          ]
        },
        "featureOrderSha256": {
          "$ref": "#/$defs/p1/sha"
        },
        "target": {
          "const": "target_cases_next_2w"
        },
        "horizonWeeks": {
          "const": 2
        },
        "folds": {
          "type": "array",
          "minItems": 68,
          "maxItems": 68,
          "items": {
            "$ref": "#/$defs/p1/fold"
          }
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assessmentId",
        "jobId",
        "workspaceId",
        "datasetId",
        "deploymentId",
        "assessmentPolicy",
        "candidateRegistrySha256",
        "foldPolicy",
        "foldPlanSha256",
        "plannedFoldCount",
        "candidateIds",
        "featureOrderSha256",
        "target",
        "horizonWeeks",
        "folds",
        "generatedAt",
        "labelledRows",
        "availableFoldCount",
        "foldCapApplied",
        "selectedValidationStartIndex",
        "selectedValidationEndIndex",
        "selectedEvaluationPeriod"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2.0"
        },
        "assessmentId": {
          "$ref": "#/$defs/p2/uuid"
        },
        "jobId": {
          "$ref": "#/$defs/p2/uuid"
        },
        "workspaceId": {
          "$ref": "#/$defs/p2/uuid"
        },
        "datasetId": {
          "$ref": "#/$defs/p2/sha"
        },
        "deploymentId": {
          "const": "dhaka_south"
        },
        "assessmentPolicy": {
          "$ref": "#/$defs/p2/assessmentPolicy"
        },
        "candidateRegistrySha256": {
          "$ref": "#/$defs/p2/sha"
        },
        "foldPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
            "policyVersion",
            "trainingWindow",
            "initialTrainingRows",
            "embargoRows",
            "validationRowsPerFold",
            "stepSizeWeeks",
            "samePlanForAllCandidates",
            "minimumFoldCount",
            "maximumFoldCount",
            "foldSelectionRule"
          ],
          "properties": {
            "policyId": {
              "const": "RUNTIME.ASSESSMENT.DYNAMIC_EXPANDING_FOLDS"
            },
            "policyVersion": {
              "const": "p2-v1"
            },
            "trainingWindow": {
              "const": "expanding"
            },
            "initialTrainingRows": {
              "const": 104
            },
            "embargoRows": {
              "const": 1
            },
            "targetPurgeRows": {
              "const": 2
            },
            "validationRowsPerFold": {
              "const": 1
            },
            "stepSizeWeeks": {
              "const": 1
            },
            "samePlanForAllCandidates": {
              "const": true
            },
            "minimumFoldCount": {
              "const": 52
            },
            "maximumFoldCount": {
              "const": 68
            },
            "foldSelectionRule": {
              "const": "most_recent_contiguous_validation_indexes_up_to_maximum_fold_count"
            }
          }
        },
        "foldPlanSha256": {
          "$ref": "#/$defs/p2/sha"
        },
        "plannedFoldCount": {
          "type": "integer",
          "minimum": 52,
          "maximum": 68
        },
        "candidateIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/p2/modelId"}
        },
        "featureOrderSha256": {
          "$ref": "#/$defs/p2/sha"
        },
        "target": {
          "const": "target_cases_next_2w"
        },
        "horizonWeeks": {
          "const": 2
        },
        "folds": {
          "type": "array",
          "minItems": 52,
          "maxItems": 68,
          "items": {
            "$ref": "#/$defs/p2/fold"
          }
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "labelledRows": {
          "type": "integer",
          "minimum": 157
        },
        "availableFoldCount": {
          "type": "integer",
          "minimum": 52
        },
        "foldCapApplied": {
          "type": "boolean"
        },
        "selectedValidationStartIndex": {
          "type": "integer",
          "minimum": 105
        },
        "selectedValidationEndIndex": {
          "type": "integer",
          "minimum": 156
        },
        "selectedEvaluationPeriod": {
          "$ref": "#/$defs/p2/range"
        },
        "scientificValidation": {
          "$ref": "#/$defs/scientificValidation"
        },
        "uncertaintyCalibration": {
          "$ref": "#/$defs/uncertaintyCalibration"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessmentPolicy": {
                "properties": {"policyVersion": {"const": "p2-v1"}},
                "required": ["policyVersion"]
              }
            },
            "required": ["assessmentPolicy"]
          },
          "then": {
            "properties": {
              "candidateIds": {
                "const": ["previous_week_naive", "moving_average_4w", "seasonal_naive_52w", "ridge_regression", "poisson_regression", "random_forest", "gradient_boosting"]
              },
              "folds": {
                "items": {
                  "properties": {
                    "predictions": {
                      "minItems": 7,
                      "maxItems": 7,
                      "items": {
                        "allOf": [
                          {"$ref": "#/$defs/p2/prediction"},
                          {"properties": {"modelId": {"$ref": "#/$defs/p2/legacyModelId"}}}
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
