        "additionalProperties": false,
        "required": [
          "foldId",
          "sequence",
          "trainingPeriod",
          "trainingRowCount",
          "embargoPeriod",
          "forecastOrigin",
          "targetPeriod",
          "actualTarget",
          "targetTrajectory",
          "featureOrderSha256",
          "trainingMatrixSha256",
          "validationMatrixSha256",
