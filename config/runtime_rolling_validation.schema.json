          "featureOrderSha256": {
            "$ref": "#/$defs/p1/sha"
          },
          "trainingMatrixSha256": {
            "$ref": "#/$defs/p1/sha"
          },
          "validationMatrixSha256": {
            "$ref": "#/$defs/p1/sha"
          },
          "labelAvailabilityRule": {
            "type": "string",
            "minLength": 1
          },
          "predictions": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "$ref": "#/$defs/p1/prediction"
            }
          }
        }
      }
