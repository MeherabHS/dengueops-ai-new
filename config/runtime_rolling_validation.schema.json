          "publishedPrediction",
          "clippingApplied",
          "signedError",
          "absoluteError",
          "squaredError",
          "failureReasonCode",
          "warningCodes",
          "runtimeSeconds"
        ],
        "properties": {
          "modelId": {
            "$ref": "#/$defs/p2/modelId"
          },
          "foldStatus": {
            "enum": [
