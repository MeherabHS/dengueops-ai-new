            "$ref": "#/$defs/p1/modelId"
          },
          "foldStatus": {
            "enum": [
              "success",
              "warning",
              "failed"
            ]
          },
          "rawPrediction": {
            "type": [
              "number",
              "null"
            ]
          },
          "publishedPrediction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "clippingApplied": {
            "type": "boolean"
          },
          "signedError": {
            "type": [
              "number",
              "null"
            ]
          },
          "absoluteError": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "squaredError": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "failureReasonCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "warningCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtimeSeconds": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "fold": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "foldId",
          "sequence",
          "trainingPeriod",
          "trainingRowCount",
          "embargoPeriod",
