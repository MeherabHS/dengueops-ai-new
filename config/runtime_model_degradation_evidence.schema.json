{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p2"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policySha256"],
      "properties": {
        "policyId": {"type": "string", "minLength": 1},
        "policyVersion": {"type": "string", "minLength": 1},
        "policySha256": {"$ref": "#/$defs/sha"}
      }
    },
    "outcomeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomeId", "outcomeCommitSha256", "outcomeEvidenceSha256", "sourceForecastRunId", "targetPeriod"],
      "properties": {
        "outcomeId": {"format": "uuid"},
        "outcomeCommitSha256": {"$ref": "#/$defs/sha"},
        "outcomeEvidenceSha256": {"$ref": "#/$defs/sha"},
        "sourceForecastRunId": {"format": "uuid"},
        "targetPeriod": {"$ref": "#/$defs/period"}
      }
    },
    "trainingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trainingRowCounts", "trainingPeriods", "featureMatrixSha256s", "assessmentIds", "decisionIds", "variationRecorded"],
      "properties": {
        "trainingRowCounts": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 157}},
        "trainingPeriods": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "featureMatrixSha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
        "assessmentIds": {"type": "array", "uniqueItems": true, "items": {"format": "uuid"}},
        "decisionIds": {"type": "array", "uniqueItems": true, "items": {"format": "uuid"}},
        "variationRecorded": {"type": "boolean"}
      }
    },
    "assessmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceType", "assessmentId", "assessmentCommitSha256", "candidateComparisonSha256", "assessmentPolicy", "modelId", "modelFamily", "parameterSha256", "foldPlanSha256", "selectedEvaluationPeriod", "plannedFoldCount", "successfulFolds", "failedFolds", "observedOutcomeCount", "assessmentMAE", "observedMAE", "maeDelta", "maeRatio", "assessmentRMSE", "observedRMSE", "rmseDelta", "rmseRatio", "clippingCount", "comparabilityStatus", "forecastValueBasisStatus", "sampleSufficiencyStatus", "materialWorseningStatus", "lifecycleActionStatus", "evidenceState"],
      "properties": {
        "referenceType": {"const": "committed_assessment"},
        "assessmentId": {"format": "uuid"},
        "assessmentCommitSha256": {"$ref": "#/$defs/sha"},
        "candidateComparisonSha256": {"$ref": "#/$defs/sha"},
        "assessmentPolicy": {"$ref": "#/$defs/policy"},
        "modelId": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "parameterSha256": {"$ref": "#/$defs/sha"},
        "foldPlanSha256": {"$ref": "#/$defs/sha"},
        "selectedEvaluationPeriod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {"start": {"$ref": "#/$defs/period"}, "end": {"$ref": "#/$defs/period"}}
        },
        "plannedFoldCount": {"type": "integer", "minimum": 52, "maximum": 68},
        "successfulFolds": {"type": "integer", "minimum": 52, "maximum": 68},
        "failedFolds": {"const": 0},
        "observedOutcomeCount": {"type": "integer", "minimum": 1},
        "assessmentMAE": {"type": "number", "minimum": 0},
        "observedMAE": {"type": "number", "minimum": 0},
        "maeDelta": {"type": "number"},
        "maeRatio": {"type": ["number", "null"]},
        "assessmentRMSE": {"type": "number", "minimum": 0},
        "observedRMSE": {"type": "number", "minimum": 0},
        "rmseDelta": {"type": "number"},
        "rmseRatio": {"type": ["number", "null"]},
        "clippingCount": {"type": "integer", "minimum": 0},
        "comparabilityStatus": {"const": "limited_cross_population_comparability"},
        "forecastValueBasisStatus": {"enum": ["equivalent_no_clipping_observed", "forecast_value_basis_mismatch"]},
        "sampleSufficiencyStatus": {"const": "not_governed"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"},
        "evidenceState": {"const": "computable_descriptive_evidence"}
      }
    },
    "legacyPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "positiveActualCount", "zeroActualCount", "actualSum", "actualMean", "actualMinimum", "actualMaximum", "mae", "rmse", "signedBias", "absoluteBias", "mpe", "mape", "percentageEligibleCount", "rangeEligibleCount", "empiricalCoverage"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "positiveActualCount": {"type": "integer", "minimum": 0},
        "zeroActualCount": {"type": "integer", "minimum": 0},
        "actualSum": {"type": "number", "minimum": 0},
        "actualMean": {"type": "number", "minimum": 0},
        "actualMinimum": {"type": "number", "minimum": 0},
        "actualMaximum": {"type": "number", "minimum": 0},
        "mae": {"type": "number", "minimum": 0},
        "rmse": {"type": "number", "minimum": 0},
        "signedBias": {"type": "number"},
        "absoluteBias": {"type": "number", "minimum": 0},
        "mpe": {"type": ["number", "null"]},
        "mape": {"type": ["number", "null"], "minimum": 0},
        "percentageEligibleCount": {"type": "integer", "minimum": 0},
        "rangeEligibleCount": {"type": "integer", "minimum": 0},
        "empiricalCoverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "population2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "positiveActualCount", "zeroActualCount", "actualSum", "actualMean", "actualMinimum", "actualMaximum", "mae", "rmse", "signedBias", "absoluteBias", "mpe", "mape", "percentageEligibleCount", "rangeEligibleCount", "empiricalRangeEvaluatedCount", "empiricalRangeCoveredCount", "empiricalCoverage", "lowerMissCount", "upperMissCount"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "positiveActualCount": {"type": "integer", "minimum": 0},
        "zeroActualCount": {"type": "integer", "minimum": 0},
        "actualSum": {"type": "number", "minimum": 0},
        "actualMean": {"type": "number", "minimum": 0},
        "actualMinimum": {"type": "number", "minimum": 0},
        "actualMaximum": {"type": "number", "minimum": 0},
        "mae": {"type": "number", "minimum": 0},
        "rmse": {"type": "number", "minimum": 0},
        "signedBias": {"type": "number"},
        "absoluteBias": {"type": "number", "minimum": 0},
        "mpe": {"type": ["number", "null"]},
        "mape": {"type": ["number", "null"], "minimum": 0},
        "percentageEligibleCount": {"type": "integer", "minimum": 0},
        "rangeEligibleCount": {"type": "integer", "minimum": 0},
        "empiricalRangeEvaluatedCount": {"type": "integer", "minimum": 0},
        "empiricalRangeCoveredCount": {"type": "integer", "minimum": 0},
        "empiricalCoverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "lowerMissCount": {"type": "integer", "minimum": 0},
        "upperMissCount": {"type": "integer", "minimum": 0}
      }
    },
    "legacyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "geography", "target", "forecastHorizonWeeks", "sourceFamily", "monitoringPolicy", "forecastPolicy", "modelId", "modelFamily", "parameterSha256", "featureOrderSha256", "candidateRegistrySha256", "assessmentPolicy", "decisionPolicy", "uncertaintyStatus"],
      "properties": {
        "deploymentId": {"const": "dhaka_south"},
        "geography": {"const": {"level": "city", "id": "BGD-DHAKA-SOUTH", "name": "Dhaka South"}},
        "target": {"const": "target_cases_next_2w"},
        "forecastHorizonWeeks": {"const": 2},
        "sourceFamily": {"enum": ["quick_forecast_p1", "approved_forecast_p1", "approved_forecast_p2"]},
        "monitoringPolicy": {"$ref": "#/$defs/policy"},
        "forecastPolicy": {"$ref": "#/$defs/policy"},
        "modelId": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "parameterSha256": {"$ref": "#/$defs/sha"},
        "featureOrderSha256": {"$ref": "#/$defs/sha"},
        "candidateRegistrySha256": {"$ref": "#/$defs/sha"},
        "assessmentPolicy": {"oneOf": [{"$ref": "#/$defs/policy"}, {"type": "null"}]},
        "decisionPolicy": {"oneOf": [{"$ref": "#/$defs/policy"}, {"type": "null"}]},
        "uncertaintyStatus": {"enum": ["available", "pending_dataset_specific_calibration", "pending_selected_model_calibration"]}
      }
    },
    "identity2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentId", "sourceFamily", "modelId", "modelFamily", "parameterSha256", "preprocessingIdentity", "candidateRegistrySha256", "featureOrderSha256", "sourcePolicy", "forecastHorizonWeeks", "forecastPresentationMode", "calibrationStatus"],
      "properties": {
        "deploymentId": {"const": "dhaka_south"},
        "sourceFamily": {"enum": ["quick_forecast_p1", "quick_forecast_p2", "approved_forecast_p1", "approved_forecast_p2"]},
        "modelId": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "parameterSha256": {"$ref": "#/$defs/sha"},
        "preprocessingIdentity": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "candidateRegistrySha256": {"$ref": "#/$defs/sha"},
        "featureOrderSha256": {"$ref": "#/$defs/sha"},
        "sourcePolicy": {"$ref": "#/$defs/policy"},
        "forecastHorizonWeeks": {"const": 2},
        "forecastPresentationMode": {"enum": ["historical", "point_only", "point_and_interval"]},
        "calibrationStatus": {"enum": ["available", "pending_dataset_specific_calibration", "pending_selected_model_calibration", "historical", "unavailable", "governed_available"]}
      }
    },
    "assignmentProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId", "assignmentCommitSha256", "assignmentAction", "authoritySnapshotSha256", "lifecyclePolicy"],
      "properties": {
        "assignmentId": {"format": "uuid"},
        "assignmentCommitSha256": {"$ref": "#/$defs/sha"},
        "assignmentAction": {"const": "assign_selected_model"},
        "authoritySnapshotSha256": {"$ref": "#/$defs/sha"},
        "lifecyclePolicy": {"$ref": "#/$defs/policy"}
      }
    },
    "legacyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "windowOutcomeCount", "metricsCalculated", "sampleSufficiencyStatus", "materialWorseningStatus", "lifecycleActionStatus"],
      "properties": {
        "status": {"const": "window_size_not_governed"},
        "windowOutcomeCount": {"type": "null"},
        "metricsCalculated": {"const": false},
        "sampleSufficiencyStatus": {"const": "not_governed"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"}
      }
    },
    "window2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "windowOutcomeCount", "metricsCalculated", "statisticalSufficiencyStatus", "materialWorseningStatus", "lifecycleActionStatus"],
      "properties": {
        "status": {"const": "window_size_not_governed"},
        "windowOutcomeCount": {"type": "null"},
        "metricsCalculated": {"const": false},
        "statisticalSufficiencyStatus": {"const": "not_governed"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"}
      }
    },
    "legacyCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohortId", "identity", "outcomeCount", "orderedOutcomes", "outcomeSetSha256", "actualPopulation", "trainingContext", "assessmentReferenceStatus", "assessmentReferences", "monitoringWindow", "warnings"],
      "properties": {
        "cohortId": {"$ref": "#/$defs/sha"},
        "identity": {"$ref": "#/$defs/legacyIdentity"},
        "outcomeCount": {"type": "integer", "minimum": 1},
        "orderedOutcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcomeRef"}},
        "outcomeSetSha256": {"$ref": "#/$defs/sha"},
        "actualPopulation": {"$ref": "#/$defs/legacyPopulation"},
        "trainingContext": {"$ref": "#/$defs/trainingContext"},
        "assessmentReferenceStatus": {"enum": ["computable_descriptive_evidence", "not_applicable_no_assessment_reference"]},
        "assessmentReferences": {"type": "array", "items": {"$ref": "#/$defs/assessmentReference"}},
        "monitoringWindow": {"$ref": "#/$defs/legacyWindow"},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "cohort2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohortId", "identity", "outcomeCount", "orderedOutcomes", "outcomeSetSha256", "actualPopulation", "trainingContext", "assignmentProvenance", "assessmentReferenceStatus", "assessmentReferences", "monitoringWindow", "warnings"],
      "properties": {
        "cohortId": {"$ref": "#/$defs/sha"},
        "identity": {"$ref": "#/$defs/identity2"},
        "outcomeCount": {"type": "integer", "minimum": 1},
        "orderedOutcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcomeRef"}},
        "outcomeSetSha256": {"$ref": "#/$defs/sha"},
        "actualPopulation": {"$ref": "#/$defs/population2"},
        "trainingContext": {"$ref": "#/$defs/trainingContext"},
        "assignmentProvenance": {"type": "array", "items": {"$ref": "#/$defs/assignmentProvenance"}},
        "assessmentReferenceStatus": {"enum": ["computable_descriptive_evidence", "not_applicable_no_assessment_reference"]},
        "assessmentReferences": {"type": "array", "items": {"$ref": "#/$defs/assessmentReference"}},
        "monitoringWindow": {"$ref": "#/$defs/window2"},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "jobId", "deploymentId", "geography", "degradationPolicy", "monitoringPolicy", "monitoringInput", "evidenceStatus", "materialWorseningStatus", "lifecycleActionStatus", "cohorts", "includedCohortSetSha256", "generatedAt", "limitations"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "evidenceId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "geography": {"const": {"level": "city", "id": "BGD-DHAKA-SOUTH", "name": "Dhaka South"}},
        "degradationPolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "policyVersion", "policySha256"], "properties": {"policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"}, "policyVersion": {"const": "p2-v1"}, "policySha256": {"$ref": "#/$defs/sha"}}},
        "monitoringPolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "policyVersion", "policySha256"], "properties": {"policyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"}, "policyVersion": {"const": "p2-v1"}, "policySha256": {"const": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"}}},
        "monitoringInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latestPath", "latestSha256", "summaryPath", "summarySha256", "includedOutcomeSetSha256", "verifiedOutcomeCount"],
          "properties": {
            "latestPath": {"const": "deployments/dhaka_south/monitoring/latest.json"},
            "latestSha256": {"$ref": "#/$defs/sha"},
            "summaryPath": {"type": "string", "pattern": "^forecast-outcomes/[0-9a-f-]+/artifacts/monitoring_summary\\.json$"},
            "summarySha256": {"$ref": "#/$defs/sha"},
            "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
            "verifiedOutcomeCount": {"type": "integer", "minimum": 1}
          }
        },
        "evidenceStatus": {"const": "evidence_only"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"},
        "cohorts": {"type": "array", "items": {"$ref": "#/$defs/legacyCohort"}},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "jobId", "deploymentId", "geography", "degradationPolicy", "monitoringPolicy", "monitoringInput", "evidenceStatus", "degradationThresholdStatus", "degradationThresholds", "statisticalSufficiencyStatus", "materialWorseningClassificationAllowed", "materialWorseningStatus", "lifecycleRecommendationAllowed", "lifecycleActionProduced", "lifecycleActionStatus", "cohorts", "includedCohortSetSha256", "generatedAt", "limitations"],
      "properties": {
        "schemaVersion": {"const": "2.0"},
        "evidenceId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "geography": {"const": {"level": "city", "id": "BGD-DHAKA-SOUTH", "name": "Dhaka South"}},
        "degradationPolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "policyVersion", "policySha256"], "properties": {"policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"}, "policyVersion": {"const": "p2-v2"}, "policySha256": {"const": "69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98"}}},
        "monitoringPolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "policyVersion", "policySha256", "schemaVersion"], "properties": {"policyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"}, "policyVersion": {"const": "p2-v2"}, "policySha256": {"const": "5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6"}, "schemaVersion": {"const": "2.1"}}},
        "monitoringInput": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latestSnapshotPath", "latestSnapshotSha256", "summaryPath", "summarySha256", "includedOutcomeSetSha256", "verifiedOutcomeCount"],
          "properties": {
            "latestSnapshotPath": {"const": "artifacts/monitoring_latest_snapshot.json"},
            "latestSnapshotSha256": {"$ref": "#/$defs/sha"},
            "summaryPath": {"type": "string", "pattern": "^forecast-outcomes/[0-9a-f-]+/artifacts/monitoring_summary\\.json$"},
            "summarySha256": {"$ref": "#/$defs/sha"},
            "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
            "verifiedOutcomeCount": {"type": "integer", "minimum": 1}
          }
        },
        "evidenceStatus": {"const": "evidence_only"},
        "degradationThresholdStatus": {"const": "not_governed"},
        "degradationThresholds": {"type": "null"},
        "statisticalSufficiencyStatus": {"const": "not_governed"},
        "materialWorseningClassificationAllowed": {"const": false},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleRecommendationAllowed": {"const": false},
        "lifecycleActionProduced": {"const": false},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"},
        "cohorts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cohort2"}},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
