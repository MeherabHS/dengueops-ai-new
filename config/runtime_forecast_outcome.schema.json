{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/phase1Strict" },
    { "$ref": "#/$defs/phase2" },
    { "$ref": "#/$defs/phase21" }
  ],
  "$defs": {
    "phase1Strict": {
      "allOf": [
        { "$ref": "#/$defs/phase1" },
        {
          "if": {
            "properties": { "percentageMetricStatus": { "const": "available" } }
          },
          "then": {
            "properties": {
              "percentageError": { "type": "number" },
              "absolutePercentageError": { "type": "number", "minimum": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "percentageMetricStatus": {
                "const": "not_evaluable_zero_observed"
              }
            }
          },
          "then": {
            "properties": {
              "observedRaw": { "const": 0 },
              "percentageError": { "type": "null" },
              "absolutePercentageError": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "empiricalRangeStatus": { "const": "available" } }
          },
          "then": {
            "properties": {
              "lowerRaw": { "type": "number", "minimum": 0 },
              "upperRaw": { "type": "number", "minimum": 0 },
              "intervalWidth": { "type": "number", "minimum": 0 },
              "coverageOutcome": {
                "enum": ["covered", "lower_miss", "upper_miss"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "empiricalRangeStatus": {
                "const": "pending_dataset_specific_calibration"
              }
            }
          },
          "then": {
            "properties": {
              "lowerRaw": { "type": "null" },
              "upperRaw": { "type": "null" },
              "intervalWidth": { "type": "null" },
              "coverageOutcome": { "const": "not_evaluable_no_empirical_range" }
            }
          }
        }
      ]
    },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "period": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/period" },
        "end": { "$ref": "#/$defs/period" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policySha256"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "policySha256": { "$ref": "#/$defs/sha" }
      }
    },
    "monitoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policySha256"],
      "properties": {
        "policyId": { "const": "RUNTIME.FORECAST_OUTCOME.MONITORING" },
        "policyVersion": { "const": "p2-v1" },
        "policySha256": {
          "const": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"
        }
      }
    },
    "monitoringPolicy21": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyVersion", "policySha256"],
      "properties": {
        "policyId": { "const": "RUNTIME.FORECAST_OUTCOME.MONITORING" },
        "policyVersion": { "enum": ["p2-v2", "p2-v3"] },
        "policySha256": {
          "enum": [
            "5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6",
            "cc3b533b7cfc16b841401b7a60f6308632526f58d5685578d7f368dec96a09d9"
          ]
        }
      }
    },
    "quickEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecastOutputPath",
        "forecastOutputSha256",
        "forecastUncertaintyPath",
        "forecastUncertaintySha256",
        "forecastCalibrationPath",
        "forecastCalibrationSha256",
        "modelCardPath",
        "modelCardSha256",
        "sourcePolicy"
      ],
      "properties": {
        "forecastOutputPath": { "const": "artifacts/forecast_output.json" },
        "forecastOutputSha256": { "$ref": "#/$defs/sha" },
        "forecastUncertaintyPath": {
          "const": "artifacts/forecast_uncertainty.json"
        },
        "forecastUncertaintySha256": { "$ref": "#/$defs/sha" },
        "forecastCalibrationPath": {
          "const": "artifacts/forecast_calibration.json"
        },
        "forecastCalibrationSha256": { "$ref": "#/$defs/sha" },
        "modelCardPath": { "const": "artifacts/model_card.json" },
        "modelCardSha256": { "$ref": "#/$defs/sha" },
        "sourcePolicy": { "$ref": "#/$defs/policy" }
      }
    },
    "assignmentProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "assignmentCommitSha256",
        "assignmentAction",
        "authoritySnapshotSha256",
        "lifecyclePolicy"
      ],
      "properties": {
        "assignmentId": { "format": "uuid" },
        "assignmentCommitSha256": { "$ref": "#/$defs/sha" },
        "assignmentAction": { "const": "assign_selected_model" },
        "authoritySnapshotSha256": { "$ref": "#/$defs/sha" },
        "lifecyclePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyId", "policyVersion", "policySha256"],
          "properties": {
            "policyId": { "const": "RUNTIME.MODEL_LIFECYCLE.DECISION" },
            "policyVersion": { "enum": ["p2-v2", "p2-v3"] },
            "policySha256": {
              "enum": [
                "294b7949adecc39b284adaa198db47109ee4b1cc39259e87bc9073e1bff93b64",
                "ae50f6e29ab0caba16401b5314c7d26c75658887d78a36c0b0d7c029a5b6a86a"
              ]
            }
          }
        }
      }
    },
    "quickP2Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecastOutputPath",
        "forecastOutputSha256",
        "forecastUncertaintyPath",
        "forecastUncertaintySha256",
        "forecastCalibrationPath",
        "forecastCalibrationSha256",
        "modelCardPath",
        "modelCardSha256",
        "sourcePolicy",
        "runRecordPath",
        "runRecordSha256",
        "assessmentReferenceStatus",
        "assignmentProvenance",
        "forecastPresentationMode",
        "calibrationStatus",
        "uncertaintyReasonCode",
        "deploymentModelAdopted"
      ],
      "properties": {
        "forecastOutputPath": { "const": "artifacts/forecast_output.json" },
        "forecastOutputSha256": { "$ref": "#/$defs/sha" },
        "forecastUncertaintyPath": {
          "const": "artifacts/forecast_uncertainty.json"
        },
        "forecastUncertaintySha256": { "$ref": "#/$defs/sha" },
        "forecastCalibrationPath": {
          "const": "artifacts/forecast_calibration.json"
        },
        "forecastCalibrationSha256": { "$ref": "#/$defs/sha" },
        "modelCardPath": { "const": "artifacts/model_card.json" },
        "modelCardSha256": { "$ref": "#/$defs/sha" },
        "sourcePolicy": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["policyId", "policyVersion", "policySha256"],
              "properties": {
                "policyId": {
                  "const": "RUNTIME.QUICK_FORECAST.COMPATIBILITY"
                },
                "policyVersion": { "const": "p2-v1" },
                "policySha256": {
                  "const": "4a6f166d037ab4c69df980549626d993db473bcec325fa2a68dbe5f8485a757e"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["policyId", "policyVersion", "policySha256"],
              "properties": {
                "policyId": {
                  "const": "RUNTIME.QUICK_FORECAST.COMPATIBILITY"
                },
                "policyVersion": { "const": "p2-v2" },
                "policySha256": {
                  "const": "09c338d56737ba35b5a0db82c97a7e26222297dfbb07cba36bf0e5f831b9adc2"
                }
              }
            }
          ]
        },
        "runRecordPath": { "const": "metadata/run.json" },
        "runRecordSha256": { "$ref": "#/$defs/sha" },
        "assessmentReferenceStatus": {
          "const": "not_applicable_no_assessment_reference"
        },
        "assignmentProvenance": { "$ref": "#/$defs/assignmentProvenance" },
        "forecastPresentationMode": {
          "enum": ["point_and_interval", "point_only"]
        },
        "calibrationStatus": { "enum": ["governed_available", "unavailable"] },
        "uncertaintyReasonCode": { "type": ["string", "null"] },
        "deploymentModelAdopted": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "calibrationStatus": { "const": "governed_available" }
            }
          },
          "then": {
            "properties": {
              "forecastPresentationMode": { "const": "point_and_interval" },
              "uncertaintyReasonCode": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "calibrationStatus": { "const": "unavailable" } }
          },
          "then": {
            "properties": {
              "forecastPresentationMode": { "const": "point_only" },
              "uncertaintyReasonCode": {
                "const": "model_calibration_unavailable"
              }
            }
          }
        }
      ]
    },
    "approvedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecastOutputPath",
        "forecastOutputSha256",
        "forecastUncertaintyPath",
        "forecastUncertaintySha256",
        "modelCardPath",
        "modelCardSha256",
        "sourcePolicy",
        "assessmentId",
        "assessmentCommitSha256",
        "assessmentPolicy",
        "decisionId",
        "decisionCommitSha256",
        "decisionPolicy",
        "authorizationId",
        "authorizationCommitSha256",
        "technicalWinnerModelId",
        "technicalWinnerParameterSha256",
        "trainingRowCount",
        "trainingPeriod",
        "plannedFoldCount",
        "successfulFolds",
        "failedFolds",
        "selectedEvaluationPeriod",
        "foldPlanSha256",
        "featureMatrixSha256"
      ],
      "properties": {
        "forecastOutputPath": { "const": "artifacts/forecast_output.json" },
        "forecastOutputSha256": { "$ref": "#/$defs/sha" },
        "forecastUncertaintyPath": {
          "const": "artifacts/forecast_uncertainty.json"
        },
        "forecastUncertaintySha256": { "$ref": "#/$defs/sha" },
        "modelCardPath": { "const": "artifacts/model_card.json" },
        "modelCardSha256": { "$ref": "#/$defs/sha" },
        "sourcePolicy": { "$ref": "#/$defs/policy" },
        "assessmentId": { "format": "uuid" },
        "assessmentCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentPolicy": { "$ref": "#/$defs/policy" },
        "decisionId": { "format": "uuid" },
        "decisionCommitSha256": { "$ref": "#/$defs/sha" },
        "decisionPolicy": { "$ref": "#/$defs/policy" },
        "authorizationId": { "format": "uuid" },
        "authorizationCommitSha256": { "$ref": "#/$defs/sha" },
        "technicalWinnerModelId": { "type": ["string", "null"] },
        "technicalWinnerParameterSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "trainingRowCount": { "type": "integer", "minimum": 157 },
        "trainingPeriod": { "$ref": "#/$defs/range" },
        "plannedFoldCount": { "type": "integer", "minimum": 52, "maximum": 68 },
        "successfulFolds": { "type": "integer", "minimum": 52, "maximum": 68 },
        "failedFolds": { "const": 0 },
        "selectedEvaluationPeriod": { "$ref": "#/$defs/range" },
        "foldPlanSha256": { "$ref": "#/$defs/sha" },
        "featureMatrixSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "phase1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcomeId",
        "jobId",
        "forecastRunId",
        "forecastCommitPath",
        "forecastCommitSha256",
        "forecastOutputPath",
        "forecastOutputSha256",
        "forecastUncertaintyPath",
        "forecastUncertaintySha256",
        "forecastCalibrationPath",
        "forecastCalibrationSha256",
        "modelCardPath",
        "modelCardSha256",
        "observationArtifactPath",
        "observationArtifactSha256",
        "deploymentId",
        "datasetId",
        "geography",
        "sourceType",
        "workflowMode",
        "modelId",
        "modelFamily",
        "modelParametersSha256",
        "candidateRegistrySha256",
        "featureOrderSha256",
        "forecastPolicyId",
        "forecastPolicyVersion",
        "forecastPolicySha256",
        "targetColumn",
        "forecastHorizonWeeks",
        "forecastOriginPeriod",
        "forecastTargetPeriod",
        "forecastRaw",
        "forecastReported",
        "observedRaw",
        "signedError",
        "errorDirection",
        "absoluteError",
        "squaredError",
        "percentageError",
        "absolutePercentageError",
        "percentageMetricStatus",
        "empiricalRangeStatus",
        "lowerRaw",
        "upperRaw",
        "coverageOutcome",
        "intervalWidth",
        "evaluatedAt",
        "limitations"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "outcomeId": { "format": "uuid" },
        "jobId": { "format": "uuid" },
        "forecastRunId": { "format": "uuid" },
        "forecastCommitPath": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]+/metadata/commit\\.json$"
        },
        "forecastCommitSha256": { "$ref": "#/$defs/sha" },
        "forecastOutputPath": { "const": "artifacts/forecast_output.json" },
        "forecastOutputSha256": { "$ref": "#/$defs/sha" },
        "forecastUncertaintyPath": {
          "const": "artifacts/forecast_uncertainty.json"
        },
        "forecastUncertaintySha256": { "$ref": "#/$defs/sha" },
        "forecastCalibrationPath": {
          "const": "artifacts/forecast_calibration.json"
        },
        "forecastCalibrationSha256": { "$ref": "#/$defs/sha" },
        "modelCardPath": { "const": "artifacts/model_card.json" },
        "modelCardSha256": { "$ref": "#/$defs/sha" },
        "observationArtifactPath": { "const": "artifacts/observation.json" },
        "observationArtifactSha256": { "$ref": "#/$defs/sha" },
        "deploymentId": { "const": "dhaka_south" },
        "datasetId": { "$ref": "#/$defs/sha" },
        "geography": {
          "const": {
            "level": "city",
            "id": "BGD-DHAKA-SOUTH",
            "name": "Dhaka South"
          }
        },
        "sourceType": { "const": "uploaded" },
        "workflowMode": { "const": "quick_forecast" },
        "modelId": { "const": "random_forest" },
        "modelFamily": { "const": "RandomForestRegressor" },
        "modelParametersSha256": { "$ref": "#/$defs/sha" },
        "candidateRegistrySha256": { "$ref": "#/$defs/sha" },
        "featureOrderSha256": { "$ref": "#/$defs/sha" },
        "forecastPolicyId": { "const": "RUNTIME.QUICK_FORECAST.COMPATIBILITY" },
        "forecastPolicyVersion": { "const": "p1.4f-v1" },
        "forecastPolicySha256": { "$ref": "#/$defs/sha" },
        "targetColumn": { "const": "target_cases_next_2w" },
        "forecastHorizonWeeks": { "const": 2 },
        "forecastOriginPeriod": { "$ref": "#/$defs/period" },
        "forecastTargetPeriod": { "$ref": "#/$defs/period" },
        "forecastRaw": { "type": "number", "minimum": 0 },
        "forecastReported": { "type": "integer", "minimum": 0 },
        "observedRaw": { "type": "integer", "minimum": 0 },
        "signedError": { "type": "number" },
        "errorDirection": {
          "enum": ["underforecast", "overforecast", "exact"]
        },
        "absoluteError": { "type": "number", "minimum": 0 },
        "squaredError": { "type": "number", "minimum": 0 },
        "percentageError": { "type": ["number", "null"] },
        "absolutePercentageError": { "type": ["number", "null"], "minimum": 0 },
        "percentageMetricStatus": {
          "enum": ["available", "not_evaluable_zero_observed"]
        },
        "empiricalRangeStatus": {
          "enum": ["available", "pending_dataset_specific_calibration"]
        },
        "lowerRaw": { "type": ["number", "null"], "minimum": 0 },
        "upperRaw": { "type": ["number", "null"], "minimum": 0 },
        "coverageOutcome": {
          "enum": [
            "covered",
            "lower_miss",
            "upper_miss",
            "not_evaluable_no_empirical_range"
          ]
        },
        "intervalWidth": { "type": ["number", "null"], "minimum": 0 },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcomeId",
        "jobId",
        "monitoringPolicy",
        "sourceFamily",
        "sourceForecastRunId",
        "sourceForecastCommitPath",
        "sourceForecastCommitSha256",
        "sourceForecastSchemaVersion",
        "sourceEvidence",
        "observationArtifactPath",
        "observationArtifactSha256",
        "deploymentId",
        "datasetId",
        "geography",
        "modelId",
        "modelFamily",
        "modelParametersSha256",
        "candidateRegistrySha256",
        "featureOrderSha256",
        "sourcePolicy",
        "targetColumn",
        "forecastHorizonWeeks",
        "forecastOriginPeriod",
        "forecastTargetPeriod",
        "forecastRaw",
        "forecastReported",
        "observedRaw",
        "observationSourceType",
        "observationSourceId",
        "observationRecordId",
        "signedError",
        "errorDirection",
        "absoluteError",
        "squaredError",
        "percentageError",
        "absolutePercentageError",
        "percentageMetricStatus",
        "percentageErrorEligible",
        "empiricalRangeStatus",
        "lowerRaw",
        "upperRaw",
        "coverageOutcome",
        "intervalWidth",
        "evaluatedAt",
        "limitations"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "outcomeId": { "format": "uuid" },
        "jobId": { "format": "uuid" },
        "monitoringPolicy": { "$ref": "#/$defs/monitoringPolicy" },
        "sourceFamily": {
          "enum": [
            "quick_forecast_p1",
            "approved_forecast_p1",
            "approved_forecast_p2"
          ]
        },
        "sourceForecastRunId": { "format": "uuid" },
        "sourceForecastCommitPath": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]+/metadata/commit\\.json$"
        },
        "sourceForecastCommitSha256": { "$ref": "#/$defs/sha" },
        "sourceForecastSchemaVersion": { "enum": ["1.0", "2.0"] },
        "sourceEvidence": {
          "oneOf": [
            { "$ref": "#/$defs/quickEvidence" },
            { "$ref": "#/$defs/approvedEvidence" }
          ]
        },
        "observationArtifactPath": { "const": "artifacts/observation.json" },
        "observationArtifactSha256": { "$ref": "#/$defs/sha" },
        "deploymentId": { "const": "dhaka_south" },
        "datasetId": { "$ref": "#/$defs/sha" },
        "geography": {
          "const": {
            "level": "city",
            "id": "BGD-DHAKA-SOUTH",
            "name": "Dhaka South"
          }
        },
        "modelId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "modelFamily": { "type": "string", "minLength": 1, "maxLength": 256 },
        "modelParametersSha256": { "$ref": "#/$defs/sha" },
        "candidateRegistrySha256": {
          "enum": [
            "2e627f8a368a7e92cebd4ad62139b1050c7614559affd620e9a41738fd6a25d4",
            "74cb3635c5e211874ee5ad23196fc95bfdfbdb5c6438cc3d060f0b9ff49acfa0",
            "e6fd8aff5d092f7a9e112647515349d7aed43b21f5d78d97b8f988d492ab0226"
          ]
        },
        "featureOrderSha256": {
          "const": "aeccbe517da452e1132f08c02599418523fb003280b11ff9cda66cfb3aa55a85"
        },
        "sourcePolicy": { "$ref": "#/$defs/policy" },
        "targetColumn": { "const": "target_cases_next_2w" },
        "forecastHorizonWeeks": { "const": 2 },
        "forecastOriginPeriod": { "$ref": "#/$defs/period" },
        "forecastTargetPeriod": { "$ref": "#/$defs/period" },
        "forecastRaw": { "type": "number" },
        "forecastReported": { "type": "integer", "minimum": 0 },
        "observedRaw": { "type": "integer", "minimum": 0 },
        "observationSourceType": { "const": "synthetic_benchmark" },
        "observationSourceId": { "const": "dhaka_south_synthetic_benchmark" },
        "observationRecordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signedError": { "type": "number" },
        "errorDirection": {
          "enum": ["underforecast", "overforecast", "exact"]
        },
        "absoluteError": { "type": "number", "minimum": 0 },
        "squaredError": { "type": "number", "minimum": 0 },
        "percentageError": { "type": ["number", "null"] },
        "absolutePercentageError": { "type": ["number", "null"], "minimum": 0 },
        "percentageMetricStatus": {
          "enum": ["available", "not_evaluable_zero_observed"]
        },
        "percentageErrorEligible": { "type": "boolean" },
        "empiricalRangeStatus": {
          "enum": [
            "available",
            "pending_dataset_specific_calibration",
            "pending_selected_model_calibration"
          ]
        },
        "lowerRaw": { "type": ["number", "null"], "minimum": 0 },
        "upperRaw": { "type": ["number", "null"], "minimum": 0 },
        "coverageOutcome": {
          "enum": [
            "covered",
            "lower_miss",
            "upper_miss",
            "not_evaluable_no_empirical_range"
          ]
        },
        "intervalWidth": { "type": ["number", "null"], "minimum": 0 },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sourceFamily": { "const": "quick_forecast_p1" } }
          },
          "then": {
            "properties": {
              "sourceForecastSchemaVersion": { "const": "1.0" },
              "sourceEvidence": { "$ref": "#/$defs/quickEvidence" },
              "modelId": { "const": "random_forest" },
              "modelFamily": { "const": "RandomForestRegressor" },
              "candidateRegistrySha256": {
                "const": "2e627f8a368a7e92cebd4ad62139b1050c7614559affd620e9a41738fd6a25d4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceFamily": { "const": "approved_forecast_p1" }
            }
          },
          "then": {
            "properties": {
              "sourceForecastSchemaVersion": { "const": "1.0" },
