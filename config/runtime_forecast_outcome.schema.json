        "sourceForecastSchemaVersion": { "enum": ["1.0", "2.0", "2.1"] },
        "sourceEvidence": {
          "oneOf": [
            { "$ref": "#/$defs/quickEvidence" },
            { "$ref": "#/$defs/quickP2Evidence" },
