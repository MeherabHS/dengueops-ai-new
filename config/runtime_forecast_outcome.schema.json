        },
        {
          "if": {
            "properties": { "empiricalRangeStatus": { "const": "available" } }
          },
          "then": {
            "properties": {
              "lowerRaw": { "type": "number", "minimum": 0 },
              "upperRaw": { "type": "number", "minimum": 0 },
              "intervalWidth": { "type": "number", "minimum": 0 },
              "coverageOutcome": {
                "enum": ["covered", "lower_miss", "upper_miss"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
