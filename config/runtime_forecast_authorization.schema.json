{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/phase1" },
    { "$ref": "#/$defs/phase2v1" },
    { "$ref": "#/$defs/phase2v2" }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model": {
      "enum": [
        "ridge_regression",
        "poisson_regression",
        "random_forest",
        "gradient_boosting"
      ]
    },
    "modelv2": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "phase1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorizationId",
        "decisionId",
        "decisionCommitSha256",
        "assessmentId",
        "assessmentCommitSha256",
        "datasetId",
        "deploymentId",
        "selectedModelId",
        "selectedModelParameterSha256",
        "workflowMode",
        "scope",
        "initialStatus",
        "createdAt",
        "expiresAt",
        "policyId",
        "policyVersion",
        "policySha256"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "authorizationId": { "format": "uuid" },
        "decisionId": { "format": "uuid" },
        "decisionCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentId": { "format": "uuid" },
        "assessmentCommitSha256": { "$ref": "#/$defs/sha" },
        "datasetId": { "$ref": "#/$defs/sha" },
        "deploymentId": { "const": "dhaka_south" },
        "selectedModelId": { "$ref": "#/$defs/model" },
        "selectedModelParameterSha256": { "$ref": "#/$defs/sha" },
        "workflowMode": { "const": "approved_assessment_forecast" },
        "scope": { "const": "one_run" },
        "initialStatus": { "const": "available" },
        "createdAt": { "format": "date-time" },
        "expiresAt": { "format": "date-time" },
        "policyId": { "const": "RUNTIME.INTERNAL_ONE_RUN_MODEL_DECISION" },
        "policyVersion": { "const": "p1.4d-3-e-v1" },
        "policySha256": { "$ref": "#/$defs/sha" }
      }
    },
    "phase2v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorizationId",
        "decisionId",
        "decisionCommitSha256",
        "assessmentId",
        "assessmentCommitSha256",
        "assessmentPolicyId",
        "assessmentPolicyVersion",
        "assessmentPolicySha256",
        "decisionPolicyId",
        "decisionPolicyVersion",
        "decisionPolicySha256",
        "datasetId",
        "deploymentId",
        "selectedModelId",
        "selectedModelParameterSha256",
        "assessmentLabelledRows",
        "assessmentPlannedFoldCount",
        "foldPlanSha256",
        "workflowMode",
        "scope",
        "initialStatus",
        "createdAt",
        "expiresAt",
        "policyId",
        "policyVersion",
        "policySha256"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "authorizationId": { "format": "uuid" },
        "decisionId": { "format": "uuid" },
        "decisionCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentId": { "format": "uuid" },
        "assessmentCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentPolicyId": {
          "const": "RUNTIME.DATASET_ASSESSMENT.GOVERNANCE"
        },
        "assessmentPolicyVersion": { "const": "p2-v1" },
        "assessmentPolicySha256": { "$ref": "#/$defs/sha" },
        "decisionPolicyId": {
          "const": "RUNTIME.INTERNAL_ONE_RUN_MODEL_DECISION"
        },
        "decisionPolicyVersion": { "const": "p2-v1" },
        "decisionPolicySha256": { "$ref": "#/$defs/sha" },
        "datasetId": { "$ref": "#/$defs/sha" },
        "deploymentId": { "const": "dhaka_south" },
        "selectedModelId": { "$ref": "#/$defs/model" },
        "selectedModelParameterSha256": { "$ref": "#/$defs/sha" },
        "assessmentLabelledRows": { "type": "integer", "minimum": 157 },
        "assessmentPlannedFoldCount": {
          "type": "integer",
          "minimum": 52,
          "maximum": 68
        },
        "foldPlanSha256": { "$ref": "#/$defs/sha" },
        "workflowMode": { "const": "approved_assessment_forecast" },
        "scope": { "const": "one_run" },
        "initialStatus": { "const": "available" },
        "createdAt": { "format": "date-time" },
        "expiresAt": { "format": "date-time" },
        "policyId": { "const": "RUNTIME.INTERNAL_ONE_RUN_MODEL_DECISION" },
        "policyVersion": { "const": "p2-v1" },
        "policySha256": { "$ref": "#/$defs/sha" }
      }
    },
    "phase2v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "authorizationId",
        "decisionId",
        "decisionCommitSha256",
        "assessmentId",
        "assessmentCommitSha256",
        "assessmentPolicyId",
        "assessmentPolicyVersion",
        "assessmentPolicySha256",
        "decisionPolicyId",
        "decisionPolicyVersion",
        "decisionPolicySha256",
        "datasetId",
        "deploymentId",
        "selectedModelId",
        "selectedModelFamily",
        "selectedModelParameterSha256",
        "selectedModelPreprocessingIdentity",
        "candidateRegistrySha256",
        "featureOrderSha256",
        "selectionType",
        "technicalWinnerModelId",
        "technicalWinnerNotSelectedAcknowledged",
        "uncertaintyLimitationsAcknowledged",
        "deploymentModelAdopted",
        "assessmentLabelledRows",
        "assessmentPlannedFoldCount",
        "foldPlanSha256",
        "workflowMode",
        "scope",
        "initialStatus",
        "createdAt",
        "expiresAt",
        "policyId",
        "policyVersion",
        "policySha256"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "authorizationId": { "format": "uuid" },
        "decisionId": { "format": "uuid" },
        "decisionCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentId": { "format": "uuid" },
        "assessmentCommitSha256": { "$ref": "#/$defs/sha" },
        "assessmentPolicyId": {
          "const": "RUNTIME.DATASET_ASSESSMENT.GOVERNANCE"
        },
        "assessmentPolicyVersion": { "enum": ["p2-v2", "p2-v3"] },
        "assessmentPolicySha256": {
          "enum": ["569faeca27a4715e72085ac97c78b00f83351bd7783fc156f5bd8f626cab28b8", "16856b96ea22f378fd619e0485ce3448c7d676250b9025625d2551724f05f1e7"]
        },
        "decisionPolicyId": {
          "const": "RUNTIME.INTERNAL_ONE_RUN_MODEL_DECISION"
        },
        "decisionPolicyVersion": { "enum": ["p2-v2", "p2-v3"] },
        "decisionPolicySha256": { "$ref": "#/$defs/sha" },
        "datasetId": { "$ref": "#/$defs/sha" },
        "deploymentId": { "const": "dhaka_south" },
        "selectedModelId": { "$ref": "#/$defs/modelv2" },
        "selectedModelFamily": { "type": "string", "minLength": 1 },
        "selectedModelParameterSha256": { "$ref": "#/$defs/sha" },
        "selectedModelPreprocessingIdentity": { "$ref": "#/$defs/sha" },
        "candidateRegistrySha256": {
          "enum": ["74cb3635c5e211874ee5ad23196fc95bfdfbdb5c6438cc3d060f0b9ff49acfa0", "e6fd8aff5d092f7a9e112647515349d7aed43b21f5d78d97b8f988d492ab0226"]
        },
        "featureOrderSha256": {
          "const": "aeccbe517da452e1132f08c02599418523fb003280b11ff9cda66cfb3aa55a85"
        },
        "selectionType": {
          "enum": ["technical_winner", "eligible_non_winner_override"]
        },
        "technicalWinnerModelId": { "type": "string", "minLength": 1 },
        "technicalWinnerNotSelectedAcknowledged": { "type": "boolean" },
        "uncertaintyLimitationsAcknowledged": { "const": true },
        "deploymentModelAdopted": { "const": false },
        "assessmentLabelledRows": { "type": "integer", "minimum": 157 },
        "assessmentPlannedFoldCount": {
          "type": "integer",
          "minimum": 52,
          "maximum": 68
        },
        "foldPlanSha256": { "$ref": "#/$defs/sha" },
        "workflowMode": { "const": "approved_assessment_forecast" },
        "scope": { "const": "one_run" },
        "initialStatus": { "const": "available" },
        "createdAt": { "format": "date-time" },
        "expiresAt": { "format": "date-time" },
        "policyId": { "const": "RUNTIME.INTERNAL_ONE_RUN_MODEL_DECISION" },
        "policyVersion": { "enum": ["p2-v2", "p2-v3"] },
        "policySha256": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
