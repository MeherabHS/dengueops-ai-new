{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p21"}
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "runId", "jobId", "workspaceId", "datasetId",
        "deploymentId", "workflowMode", "sourceType", "status", "policySha256",
        "artifactHashes", "modelCardPublishedLast", "prohibitedArtifactsAbsent",
        "committedAt"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "runId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "workspaceId": {"format": "uuid"},
        "datasetId": {"$ref": "#/$defs/sha"},
        "deploymentId": {"const": "dhaka_south"},
        "workflowMode": {"const": "quick_forecast"},
        "sourceType": {"const": "uploaded"},
        "status": {"const": "committed"},
        "policySha256": {"$ref": "#/$defs/sha"},
        "artifactHashes": {
          "type": "object",
          "minProperties": 8,
          "additionalProperties": {"$ref": "#/$defs/sha"}
        },
        "modelCardPublishedLast": {"const": true},
        "prohibitedArtifactsAbsent": {"const": true},
        "committedAt": {"format": "date-time"}
      }
    },
    "p21": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "runId", "jobId", "workspaceId", "datasetId",
        "deploymentId", "workflowMode", "sourceType", "status", "policySha256",
        "artifactHashes", "runRecordSha256", "modelCardPublishedLast",
        "prohibitedArtifactsAbsent", "committedAt"
      ],
      "properties": {
        "schemaVersion": {"const": "2.1"},
        "runId": {"format": "uuid"},
        "jobId": {"format": "uuid"},
        "workspaceId": {"format": "uuid"},
        "datasetId": {"$ref": "#/$defs/sha"},
        "deploymentId": {"const": "dhaka_south"},
        "workflowMode": {"const": "quick_forecast"},
        "sourceType": {"const": "uploaded"},
        "status": {"const": "committed"},
        "policySha256": {"$ref": "#/$defs/sha"},
        "artifactHashes": {
          "type": "object",
          "minProperties": 8,
          "additionalProperties": {"$ref": "#/$defs/sha"}
        },
        "runRecordSha256": {"$ref": "#/$defs/sha"},
        "modelCardPublishedLast": {"const": true},
        "prohibitedArtifactsAbsent": {"const": true},
        "committedAt": {"format": "date-time"}
      }
    }
  }
}
