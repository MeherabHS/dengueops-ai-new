{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "capacityReferenceId", "capacityReferenceVersion",
    "internalDeploymentId", "deploymentDisplayName", "geographicScopeDefinition",
    "evidenceScope", "operationalAvailabilityKnown", "retrievedAt",
    "sourceReferences", "hospitals", "capacityReferenceCanonicalSha256",
    "capacityReferenceContentSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "capacityReferenceId": {"$ref": "#/$defs/id"},
    "capacityReferenceVersion": {"pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$", "type": "string"},
    "internalDeploymentId": {"const": "dhaka_south"},
    "deploymentDisplayName": {"const": "Dhaka"},
    "geographicScopeDefinition": {"type": "string", "minLength": 1},
    "evidenceScope": {"const": "official_capacity_reference"},
    "operationalAvailabilityKnown": {"const": false},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "sourceReferences": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["verificationReferenceId", "sourceOrganization", "sourceUrl", "retrievedAt", "sourceAsOf", "supportedFields"],
        "properties": {
          "verificationReferenceId": {"$ref": "#/$defs/id"},
          "sourceOrganization": {"type": "string", "minLength": 1},
          "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
          "retrievedAt": {"type": "string", "format": "date-time"},
          "sourceAsOf": {"type": ["string", "null"], "format": "date-time"},
          "supportedFields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "hospitals": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "hospitalId", "officialFacilityRegistryId", "officialFacilityCode", "officialName",
          "alternateNames", "ownership", "facilityType", "cityCorporation",
          "denguePreparednessEligibility", "approvedBedCount", "revenueBedCount",
          "developmentBedCount", "latestBedCount", "latestMaleBedCount",
          "latestFemaleBedCount", "latestPayingBedCount", "latestNonPayingBedCount",
          "latestIcuBedCount", "latestHduBedCount", "latestCcuBedCount",
          "latestBedCountStatus", "selectedBedCapacity", "conflictStatus",
          "verificationReferenceId"
        ],
        "properties": {
          "hospitalId": {"$ref": "#/$defs/id"},
          "officialFacilityRegistryId": {"type": "integer", "minimum": 1},
          "officialFacilityCode": {"type": "string", "pattern": "^[0-9]+$"},
          "officialName": {"type": "string", "minLength": 1},
          "alternateNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "ownership": {"enum": ["fully_government_owned", "government_autonomous", "official_government_agency_record"]},
          "facilityType": {"type": "string", "minLength": 1},
          "cityCorporation": {"enum": ["Dhaka North City Corporation", "Dhaka South City Corporation", "metropolitan_location_registry_field_missing", "outside_city_corporation_management_included"]},
          "denguePreparednessEligibility": {"enum": ["eligible", "potentially_eligible", "not_eligible", "not_verified"]},
          "approvedBedCount": {"$ref": "#/$defs/count"},
          "revenueBedCount": {"$ref": "#/$defs/count"},
          "developmentBedCount": {"$ref": "#/$defs/count"},
          "latestBedCount": {"$ref": "#/$defs/count"},
          "latestMaleBedCount": {"$ref": "#/$defs/count"},
          "latestFemaleBedCount": {"$ref": "#/$defs/count"},
          "latestPayingBedCount": {"$ref": "#/$defs/count"},
          "latestNonPayingBedCount": {"$ref": "#/$defs/count"},
          "latestIcuBedCount": {"$ref": "#/$defs/count"},
          "latestHduBedCount": {"$ref": "#/$defs/count"},
          "latestCcuBedCount": {"$ref": "#/$defs/count"},
          "latestBedCountStatus": {"enum": ["official_nonzero", "registry_zero_not_accepted_as_operational_zero", "unavailable"]},
          "selectedBedCapacity": {
            "type": "object", "additionalProperties": false,
            "required": ["quantity", "unit", "basis", "sourceField", "sourceAsOf", "retrievedAt", "verificationReferenceId", "selectionReason", "dataQualityStatus", "availabilityStatus"],
            "properties": {
              "quantity": {"$ref": "#/$defs/count"},
              "unit": {"const": "beds"},
              "basis": {"enum": ["latest_official_operational_count", "approved_bed_count", "revenue_bed_count", "official_hospital_publication", "unavailable"]},
              "sourceField": {"type": ["string", "null"]},
              "sourceAsOf": {"type": ["string", "null"], "format": "date-time"},
              "retrievedAt": {"type": "string", "format": "date-time"},
              "verificationReferenceId": {"$ref": "#/$defs/id"},
              "selectionReason": {"type": "string", "minLength": 1},
              "dataQualityStatus": {"enum": ["official_registry_reference", "official_registry_reference_with_conflict", "unavailable"]},
              "availabilityStatus": {"const": "not_known"}
            }
          },
          "conflictStatus": {"enum": ["none", "official_values_differ", "name_and_registry_capacity_differ"]},
          "verificationReferenceId": {"$ref": "#/$defs/id"}
        }
      }
    },
    "capacityReferenceCanonicalSha256": {"$ref": "#/$defs/sha"},
    "capacityReferenceContentSha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": ["integer", "null"], "minimum": 0}
  }
}
