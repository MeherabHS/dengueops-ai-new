{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p2"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "deploymentId", "policyId", "policyVersion", "policySha256", "monitoringPolicyId", "monitoringPolicyVersion", "monitoringPolicySha256", "verifiedOutcomeCount", "cohortCount", "assessmentReferenceDimensionCount", "computableDescriptiveDimensionCount", "insufficientEvidenceDimensionCount", "windowSizeNotGovernedDimensionCount", "percentageUnavailableDimensionCount", "rangeUnavailableDimensionCount", "sourceFamilyCounts", "modelCounts", "policyCounts", "latestTargetPeriod", "includedCohortSetSha256", "includedOutcomeSetSha256", "evidenceStatus", "materialWorseningStatus", "lifecycleActionStatus", "generatedAt"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "evidenceId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"const": "p2-v1"},
        "policySha256": {"$ref": "#/$defs/sha"},
        "monitoringPolicyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"},
        "monitoringPolicyVersion": {"const": "p2-v1"},
        "monitoringPolicySha256": {"const": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"},
        "verifiedOutcomeCount": {"type": "integer", "minimum": 1},
        "cohortCount": {"type": "integer", "minimum": 1},
        "assessmentReferenceDimensionCount": {"type": "integer", "minimum": 0},
        "computableDescriptiveDimensionCount": {"type": "integer", "minimum": 0},
        "insufficientEvidenceDimensionCount": {"type": "integer", "minimum": 0},
        "windowSizeNotGovernedDimensionCount": {"type": "integer", "minimum": 1},
        "percentageUnavailableDimensionCount": {"type": "integer", "minimum": 0},
        "rangeUnavailableDimensionCount": {"type": "integer", "minimum": 0},
        "sourceFamilyCounts": {"$ref": "#/$defs/counts"},
        "modelCounts": {"$ref": "#/$defs/counts"},
        "policyCounts": {"$ref": "#/$defs/counts"},
        "latestTargetPeriod": {"$ref": "#/$defs/period"},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "evidenceStatus": {"const": "evidence_only"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"},
        "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "deploymentId", "policyId", "policyVersion", "policySha256", "monitoringPolicyId", "monitoringPolicyVersion", "monitoringPolicySha256", "verifiedOutcomeCount", "cohortCount", "assessmentReferenceDimensionCount", "computableDescriptiveDimensionCount", "windowSizeNotGovernedDimensionCount", "percentageUnavailableDimensionCount", "rangeUnavailableDimensionCount", "sourceFamilyCounts", "modelCounts", "policyCounts", "latestTargetPeriod", "includedCohortSetSha256", "includedOutcomeSetSha256", "evidenceStatus", "degradationThresholdStatus", "statisticalSufficiencyStatus", "materialWorseningStatus", "lifecycleActionStatus", "generatedAt"],
      "properties": {
        "schemaVersion": {"const": "2.0"},
        "evidenceId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"enum": ["p2-v2", "p2-v3"]},
        "policySha256": {"enum": ["69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98", "2c132daecd0a0f8579de101a540be52bff063da9cd96600419bd55331f30b9a7"]},
        "monitoringPolicyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"},
        "monitoringPolicyVersion": {"enum": ["p2-v2", "p2-v3"]},
        "monitoringPolicySha256": {"enum": ["5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6", "cc3b533b7cfc16b841401b7a60f6308632526f58d5685578d7f368dec96a09d9"]},
        "verifiedOutcomeCount": {"type": "integer", "minimum": 1},
        "cohortCount": {"type": "integer", "minimum": 1},
        "assessmentReferenceDimensionCount": {"type": "integer", "minimum": 0},
        "computableDescriptiveDimensionCount": {"type": "integer", "minimum": 1},
        "windowSizeNotGovernedDimensionCount": {"type": "integer", "minimum": 1},
        "percentageUnavailableDimensionCount": {"type": "integer", "minimum": 0},
        "rangeUnavailableDimensionCount": {"type": "integer", "minimum": 0},
        "sourceFamilyCounts": {"$ref": "#/$defs/counts"},
        "modelCounts": {"$ref": "#/$defs/counts"},
        "policyCounts": {"$ref": "#/$defs/counts"},
        "latestTargetPeriod": {"$ref": "#/$defs/period"},
        "includedCohortSetSha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "evidenceStatus": {"const": "evidence_only"},
        "degradationThresholdStatus": {"const": "not_governed"},
        "statisticalSufficiencyStatus": {"const": "not_governed"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"},
        "generatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
      },
      "allOf": [
        {
          "if": {"properties": {"policyVersion": {"const": "p2-v2"}}},
          "then": {"properties": {
            "policySha256": {"const": "69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98"},
            "monitoringPolicyVersion": {"const": "p2-v2"},
            "monitoringPolicySha256": {"const": "5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6"}
          }}
        },
        {
          "if": {"properties": {"policyVersion": {"const": "p2-v3"}}},
          "then": {"properties": {
            "policySha256": {"const": "2c132daecd0a0f8579de101a540be52bff063da9cd96600419bd55331f30b9a7"},
            "monitoringPolicyVersion": {"const": "p2-v3"},
            "monitoringPolicySha256": {"const": "cc3b533b7cfc16b841401b7a60f6308632526f58d5685578d7f368dec96a09d9"}
          }}
        }
      ]
    }
  }
}
