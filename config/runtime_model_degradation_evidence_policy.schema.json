{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p2"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "source_families", "quick_forecast_status", "reference_type", "metrics", "observed_value_basis", "assessment_value_basis", "comparability_status"],
      "properties": {
        "enabled": {"const": true},
        "source_families": {"const": ["approved_forecast_p1", "approved_forecast_p2"]},
        "quick_forecast_status": {"const": "not_applicable_no_assessment_reference"},
        "reference_type": {"const": "committed_assessment"},
        "metrics": {"const": ["mae", "rmse"]},
        "observed_value_basis": {"const": "forecastRaw"},
        "assessment_value_basis": {"const": "publishedPrediction"},
        "comparability_status": {"const": "limited_cross_population_comparability"}
      }
    },
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_id", "policy_version", "policy_status", "policy_sha256", "policy_hash_method", "deployment_id", "geography", "accepted_monitoring_policy", "accepted_source_families", "strict_cohort_identity_fields", "excluded_cohort_identity_fields", "assessment_reference", "monitoring_window", "metric_policy", "degradationThresholdStatus", "degradationThresholds", "materialWorseningClassificationAllowed", "statisticalSufficiencyStatus", "lifecycleRecommendationAllowed", "evidence_status", "material_worsening_status", "lifecycle_action_status", "prohibited_output_labels", "immutable_evidence_requirements", "prohibited_actions", "maturity_statement"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "policy_id": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policy_version": {"const": "p2-v1"},
        "policy_status": {"const": "active"},
        "policy_sha256": {"$ref": "#/$defs/sha"},
        "policy_hash_method": {"const": "sha256_canonical_json_excluding_policy_sha256"},
        "deployment_id": {"const": "dhaka_south"},
        "geography": {"const": {"level": "city", "id": "BGD-DHAKA-SOUTH", "name": "Dhaka South"}},
        "accepted_monitoring_policy": {"const": {"policy_id": "RUNTIME.FORECAST_OUTCOME.MONITORING", "policy_version": "p2-v1", "policy_sha256": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"}},
        "accepted_source_families": {"const": ["quick_forecast_p1", "approved_forecast_p1", "approved_forecast_p2"]},
        "strict_cohort_identity_fields": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"type": "string"}},
        "excluded_cohort_identity_fields": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "assessment_reference": {"$ref": "#/$defs/assessmentReference"},
        "monitoring_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_rule", "ordering", "windowSampleGovernanceStatus", "windowOutcomeCount", "adaptive_window_allowed", "half_history_split_allowed", "production_status"],
          "properties": {
            "selection_rule": {"const": "most_recent_n_and_immediately_preceding_n_within_strict_cohort"},
            "ordering": {"const": ["target_period_start", "target_period_end", "source_forecast_run_id", "outcome_id"]},
            "windowSampleGovernanceStatus": {"const": "not_governed"},
            "windowOutcomeCount": {"type": "null"},
            "adaptive_window_allowed": {"const": false},
            "half_history_split_allowed": {"const": false},
            "production_status": {"const": "window_size_not_governed"}
          }
        },
        "metric_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["residual", "mae", "rmse", "signed_bias", "absolute_bias", "mpe", "mape", "empirical_coverage", "metric_delta", "metric_ratio", "round_before_aggregation", "nonfinite_values_allowed"],
          "properties": {
            "residual": {"const": "observedRaw - forecastRaw"},
            "mae": {"const": "mean(abs(residual))"},
            "rmse": {"const": "sqrt(mean(residual ** 2))"},
            "signed_bias": {"const": "mean(residual)"},
            "absolute_bias": {"const": "abs(signedBias)"},
            "mpe": {"const": "mean(residual / observedRaw * 100 where observedRaw > 0)"},
            "mape": {"const": "mean(abs(residual / observedRaw * 100) where observedRaw > 0)"},
            "empirical_coverage": {"const": "coveredCount / rangeEligibleCount"},
            "metric_delta": {"const": "recent - reference"},
            "metric_ratio": {"const": "recent / reference when reference != 0 else null"},
            "round_before_aggregation": {"const": false},
            "nonfinite_values_allowed": {"const": false}
          }
        },
        "degradationThresholdStatus": {"const": "not_governed"},
        "degradationThresholds": {"type": "null"},
        "materialWorseningClassificationAllowed": {"const": false},
        "statisticalSufficiencyStatus": {"const": "not_governed"},
        "lifecycleRecommendationAllowed": {"const": false},
        "evidence_status": {"const": "evidence_only"},
        "material_worsening_status": {"const": "not_governed"},
        "lifecycle_action_status": {"const": "prohibited_not_generated"},
        "prohibited_output_labels": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"enum": ["healthy", "unhealthy", "degraded", "stable", "pass", "fail", "safe", "unsafe", "retain", "promote", "replace", "rollback"]}},
        "immutable_evidence_requirements": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "prohibited_actions": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"type": "string"}},
        "maturity_statement": {"type": "string", "minLength": 1}
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "policy_id", "policy_version", "policy_status", "policy_sha256", "policy_hash_method", "deployment_id", "geography", "accepted_monitoring_policy", "accepted_source_families", "performance_cohort_identity_fields", "assignment_provenance_fields", "assessment_reference", "monitoring_window", "metric_policy", "degradationThresholdStatus", "degradationThresholds", "materialWorseningClassificationAllowed", "statisticalSufficiencyStatus", "lifecycleRecommendationAllowed", "lifecycleActionProduced", "evidence_status", "material_worsening_status", "lifecycle_action_status", "prohibited_output_labels", "immutable_evidence_requirements", "prohibited_actions", "maturity_statement"],
      "properties": {
        "schema_version": {"const": "2.0"},
        "policy_id": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policy_version": {"enum": ["p2-v2", "p2-v3"]},
        "policy_status": {"const": "active"},
        "policy_sha256": {"enum": ["69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98", "2c132daecd0a0f8579de101a540be52bff063da9cd96600419bd55331f30b9a7"]},
        "policy_hash_method": {"const": "sha256_canonical_json_excluding_policy_sha256"},
        "deployment_id": {"const": "dhaka_south"},
        "geography": {"const": {"level": "city", "id": "BGD-DHAKA-SOUTH", "name": "Dhaka South"}},
        "accepted_monitoring_policy": {"enum": [{"policy_id": "RUNTIME.FORECAST_OUTCOME.MONITORING", "policy_version": "p2-v2", "policy_sha256": "5c3e1f7f14ab6a0a2fbc28639411a0269224b6f71746a315b9c6e159a6eacca6", "schema_version": "2.1"}, {"policy_id": "RUNTIME.FORECAST_OUTCOME.MONITORING", "policy_version": "p2-v3", "policy_sha256": "cc3b533b7cfc16b841401b7a60f6308632526f58d5685578d7f368dec96a09d9", "schema_version": "2.1"}]},
        "accepted_source_families": {"const": ["quick_forecast_p1", "quick_forecast_p2", "approved_forecast_p1", "approved_forecast_p2"]},
        "performance_cohort_identity_fields": {"const": ["deploymentId", "sourceFamily", "modelId", "modelFamily", "parameterSha256", "preprocessingIdentity", "candidateRegistrySha256", "featureOrderSha256", "sourcePolicy.policyId", "sourcePolicy.policyVersion", "sourcePolicy.policySha256", "forecastHorizonWeeks", "forecastPresentationMode", "calibrationStatus"]},
        "assignment_provenance_fields": {"const": ["assignmentId", "assignmentCommitSha256", "assignmentAction", "authoritySnapshotSha256", "lifecyclePolicy.policyId", "lifecyclePolicy.policyVersion", "lifecyclePolicy.policySha256"]},
        "assessment_reference": {"$ref": "#/$defs/assessmentReference"},
        "monitoring_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowSampleGovernanceStatus", "windowOutcomeCount", "adaptive_window_allowed", "half_history_split_allowed", "production_status"],
          "properties": {
            "windowSampleGovernanceStatus": {"const": "not_governed"},
            "windowOutcomeCount": {"type": "null"},
            "adaptive_window_allowed": {"const": false},
            "half_history_split_allowed": {"const": false},
            "production_status": {"const": "window_size_not_governed"}
          }
        },
        "metric_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["residual", "mae", "rmse", "signed_bias", "absolute_bias", "mpe", "mape", "empirical_coverage", "metric_delta", "metric_ratio", "round_before_aggregation", "nonfinite_values_allowed"],
          "properties": {
            "residual": {"const": "observedRaw - forecastRaw"},
            "mae": {"const": "mean(abs(residual))"},
            "rmse": {"const": "sqrt(mean(residual ** 2))"},
            "signed_bias": {"const": "mean(residual)"},
            "absolute_bias": {"const": "abs(signedBias)"},
            "mpe": {"const": "mean(residual / observedRaw * 100 where observedRaw > 0)"},
            "mape": {"const": "mean(abs(residual / observedRaw * 100) where observedRaw > 0)"},
            "empirical_coverage": {"const": "coveredCount / rangeEligibleCount"},
            "metric_delta": {"const": "observed - assessment_reference"},
            "metric_ratio": {"const": "observed / assessment_reference when assessment_reference != 0 else null"},
            "round_before_aggregation": {"const": false},
            "nonfinite_values_allowed": {"const": false}
          }
        },
        "degradationThresholdStatus": {"const": "not_governed"},
        "degradationThresholds": {"type": "null"},
        "materialWorseningClassificationAllowed": {"const": false},
        "statisticalSufficiencyStatus": {"const": "not_governed"},
        "lifecycleRecommendationAllowed": {"const": false},
        "lifecycleActionProduced": {"const": false},
        "evidence_status": {"const": "evidence_only"},
        "material_worsening_status": {"const": "not_governed"},
        "lifecycle_action_status": {"const": "prohibited_not_generated"},
        "prohibited_output_labels": {"const": ["healthy", "unhealthy", "warning", "degraded", "stable", "materially_worsened", "pass", "fail", "safe", "unsafe", "retain", "promote", "replace", "rollback"]},
        "immutable_evidence_requirements": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "prohibited_actions": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"type": "string"}},
        "maturity_statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
