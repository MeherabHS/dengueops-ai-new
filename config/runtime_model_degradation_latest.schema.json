{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/p1"},
    {"$ref": "#/$defs/p2"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "p1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "evidenceId", "deploymentId", "policyId", "policyVersion", "policySha256", "monitoringPolicyId", "monitoringPolicyVersion", "monitoringPolicySha256", "monitoringLatestInputSha256", "monitoringSummaryInputSha256", "includedOutcomeSetSha256", "evidencePath", "evidenceSha256", "summaryPath", "summarySha256", "commitPath", "commitSha256", "publishedAt", "evidenceStatus", "materialWorseningStatus", "lifecycleActionStatus"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "evidenceId": {"format": "uuid"},
        "deploymentId": {"const": "dhaka_south"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"const": "p2-v1"},
        "policySha256": {"$ref": "#/$defs/sha"},
        "monitoringPolicyId": {"const": "RUNTIME.FORECAST_OUTCOME.MONITORING"},
        "monitoringPolicyVersion": {"const": "p2-v1"},
        "monitoringPolicySha256": {"const": "c73461e211e334733309232806fa2d41c2e5fdce7aa5e096d065e13e7525eaab"},
        "monitoringLatestInputSha256": {"$ref": "#/$defs/sha"},
        "monitoringSummaryInputSha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "evidencePath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/degradation_evidence\\.json$"},
        "evidenceSha256": {"$ref": "#/$defs/sha"},
        "summaryPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/degradation_summary\\.json$"},
        "summarySha256": {"$ref": "#/$defs/sha"},
        "commitPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/metadata/commit\\.json$"},
        "commitSha256": {"$ref": "#/$defs/sha"},
        "publishedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "evidenceStatus": {"const": "evidence_only"},
        "materialWorseningStatus": {"const": "not_governed"},
        "lifecycleActionStatus": {"const": "prohibited_not_generated"}
      }
    },
    "p2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deploymentId", "evidenceId", "policyId", "policyVersion", "policySha256", "commitPath", "commitSha256", "evidencePath", "evidenceSha256", "summaryPath", "summarySha256", "monitoringLatestSnapshotPath", "monitoringLatestSnapshotSha256", "monitoringSummarySha256", "includedOutcomeSetSha256", "publishedAt"],
      "properties": {
        "schemaVersion": {"const": "2.0"},
        "deploymentId": {"const": "dhaka_south"},
        "evidenceId": {"format": "uuid"},
        "policyId": {"const": "RUNTIME.MODEL_DEGRADATION.EVIDENCE"},
        "policyVersion": {"enum": ["p2-v2", "p2-v3"]},
        "policySha256": {"enum": ["69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98", "2c132daecd0a0f8579de101a540be52bff063da9cd96600419bd55331f30b9a7"]},
        "commitPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/metadata/commit\\.json$"},
        "commitSha256": {"$ref": "#/$defs/sha"},
        "evidencePath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/degradation_evidence\\.json$"},
        "evidenceSha256": {"$ref": "#/$defs/sha"},
        "summaryPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/degradation_summary\\.json$"},
        "summarySha256": {"$ref": "#/$defs/sha"},
        "monitoringLatestSnapshotPath": {"type": "string", "pattern": "^degradation-evidence/[0-9a-f-]+/artifacts/monitoring_latest_snapshot\\.json$"},
        "monitoringLatestSnapshotSha256": {"$ref": "#/$defs/sha"},
        "monitoringSummarySha256": {"$ref": "#/$defs/sha"},
        "includedOutcomeSetSha256": {"$ref": "#/$defs/sha"},
        "publishedAt": {"type": "string", "format": "date-time", "pattern": "Z$"}
      },
      "allOf": [
        {
          "if": {"properties": {"policyVersion": {"const": "p2-v2"}}},
          "then": {"properties": {"policySha256": {"const": "69db63b59f6e0dbbd5d45e98868ce0cafae1a9407d23595c89ec52491b713c98"}}}
        },
        {
          "if": {"properties": {"policyVersion": {"const": "p2-v3"}}},
          "then": {"properties": {"policySha256": {"const": "2c132daecd0a0f8579de101a540be52bff063da9cd96600419bd55331f30b9a7"}}}
        }
      ]
    }
  }
}
