{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Dhaka hospital inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "inventoryId", "inventoryVersion", "deploymentId",
    "deploymentDisplayName", "changeReason", "createdAt", "operatorIdentifier",
    "verificationStatus", "stalenessThresholdStatus", "allocationStatus",
    "capacityReferenceId", "capacityReferenceSha256",
    "sourceReferences", "hospitals"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "inventoryId": {"$ref": "#/$defs/safeId"},
    "inventoryVersion": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "deploymentId": {"const": "dhaka_south"},
    "deploymentDisplayName": {"const": "Dhaka"},
    "changeReason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "createdAt": {"type": "string", "format": "date-time"},
    "operatorIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$"},
    "verificationStatus": {"enum": ["identity_verified_resources_unknown", "identity_and_capacity_reference_verified", "verified"]},
    "capacityReferenceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "capacityReferenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stalenessThresholdStatus": {"const": "not_governed"},
    "allocationStatus": {"enum": ["not_configured", "configured"]},
    "sourceReferences": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sourceReference"}
    },
    "hospitals": {
      "type": "array", "maxItems": 100,
      "items": {"$ref": "#/$defs/hospital"}
    }
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"},
    "sourceReference": {
      "type": "object", "additionalProperties": false,
      "required": [
        "verificationReferenceId", "sourceOrganization", "sourceUrl",
        "retrievedAt", "verifiedAt", "supportedFields"
      ],
      "properties": {
        "verificationReferenceId": {"$ref": "#/$defs/safeId"},
        "sourceOrganization": {"type": "string", "minLength": 1, "maxLength": 256},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "supportedFields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["officialName", "ownership", "location", "facilityType", "facilityIdentity", "bedCapacityReference"]}
        }
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "administrativeArea", "cityCorporation", "locationStatus"],
      "properties": {
        "address": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "administrativeArea": {"type": "string", "minLength": 1, "maxLength": 128},
        "cityCorporation": {"enum": ["Dhaka North City Corporation", "Dhaka South City Corporation", "metropolitan_location_registry_field_missing"]},
        "locationStatus": {"enum": ["official_address_verified", "official_city_corporation_only", "official_metropolitan_location_city_field_missing"]},
        "coordinates": {
          "type": "object", "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180}
          }
        }
      }
    },
    "identityVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "verificationReferenceId", "verifiedAt"],
      "properties": {
        "status": {"const": "verified"},
        "verificationReferenceId": {"$ref": "#/$defs/safeId"},
        "verifiedAt": {"type": "string", "format": "date-time"}
      }
    },
    "allocationShare": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"enum": ["not_configured", "configured"]},
        "value": {
          "type": ["string", "null"],
          "pattern": "^(?:0\\.[0-9]{6}|1\\.000000)$"
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "not_configured"}}}, "then": {"properties": {"value": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "configured"}}}, "then": {"properties": {"value": {"type": "string"}}}}
      ]
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resourceType", "unit", "quantity", "dataStatus", "availabilityStatus", "asOf", "verificationReferenceId"],
      "properties": {
        "resourceType": {"enum": ["available_beds", "total_bed_capacity", "beds_available", "beds_total", "dengue_beds", "icu_beds", "ns1_kits", "staffing"]},
        "unit": {"const": "count"},
        "quantity": {"type": ["integer", "null"], "minimum": 0},
        "dataStatus": {"enum": ["verified", "reported", "verified_capacity_reference", "unknown", "unavailable"]},
        "availabilityStatus": {"enum": ["not_known", "not_applicable"]},
        "asOf": {"type": ["string", "null"], "format": "date-time"},
        "verificationReferenceId": {"$ref": "#/$defs/safeId"}
      },
      "allOf": [
        {"if": {"properties": {"dataStatus": {"enum": ["unknown", "unavailable"]}}}, "then": {"properties": {"quantity": {"type": "null"}}}},
        {"if": {"properties": {"dataStatus": {"enum": ["verified", "reported", "verified_capacity_reference"]}}}, "then": {"properties": {"quantity": {"type": "integer"}, "asOf": {"type": "string"}}}}
      ]
    },
    "hospital": {
      "type": "object", "additionalProperties": false,
      "required": [
        "hospitalId", "officialFacilityRegistryId", "officialFacilityCode",
        "officialName", "alternateNames", "facilityType", "ownership", "active",
        "location", "identityVerification", "allocationShare", "resources"
        ,"denguePreparednessEligibility"
      ],
      "properties": {
        "hospitalId": {"$ref": "#/$defs/safeId"},
        "officialFacilityRegistryId": {"type": "integer", "minimum": 1},
        "officialFacilityCode": {"type": "string", "pattern": "^[0-9]+$"},
        "officialName": {"type": "string", "minLength": 1, "maxLength": 256},
        "alternateNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "shortName": {"type": "string", "minLength": 1, "maxLength": 128},
        "facilityType": {"type": "string", "minLength": 1, "maxLength": 128},
        "ownership": {"enum": ["public_government", "government_autonomous"]},
        "denguePreparednessEligibility": {"enum": ["eligible", "potentially_eligible", "not_eligible", "not_verified"]},
        "active": {"type": "boolean"},
        "location": {"$ref": "#/$defs/location"},
        "displayArea": {"type": "string", "minLength": 1, "maxLength": 128},
        "identityVerification": {"$ref": "#/$defs/identityVerification"},
        "allocationShare": {"$ref": "#/$defs/allocationShare"},
        "resources": {
          "type": "array", "maxItems": 20,
          "items": {"$ref": "#/$defs/resource"}
        },
        "limitations": {
          "type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
